# ========================================================
# Berkah Mandiri Inventory - Environment Template (Docker)
# ========================================================

APP_NAME="Berkah Mandiri Inventory"
APP_ENV=production
APP_KEY=base64:H9+EaJehNn+F1m5iZgsU8lraKYpjdiJSNBLeXCtJV8U=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --------------------------------------------------------
# KONEKSI DATABASE (ai_network)
# --------------------------------------------------------
# Catatan: DB_HOST diisi dengan nama container database Anda
# yang berjalan di dalam network "ai_network" (misal: mysql, db-mariadb, dll)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stock_management
DB_USERNAME=root
DB_PASSWORD=your_database_password

# --------------------------------------------------------
# SESI & CACHE
# --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# --------------------------------------------------------
# OTOMASI DOCKER ENTRYPOINT
# --------------------------------------------------------
# Set RUN_MIGRATIONS=true jika ingin otomatis php artisan migrate saat start
RUN_MIGRATIONS=true
# Port di host yang akan di-expose (default: 8080 -> diarahkan ke port 80 container)
APP_PORT=8080
